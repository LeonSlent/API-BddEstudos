# Copie para .env e preencha a URI fornecida pelo MongoDB Atlas.
# Inclua o nome do banco antes de ?, por exemplo /estudos?retryWrites=true&w=majority.
MONGODB_URI=

# Segredo exclusivo deste ambiente, com pelo menos 32 caracteres.
JWT_SECRET=
PORT=3000

# Endereços do front-end permitidos (separados por vírgula).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006,http://127.0.0.1:19006
